+    /// Append one local, II-scoped hop for a trusted receiver's public key.
+    /// This does not call the experimental session re-issuance API.
+    /// The caller must bind delivery to its document/session generation and
+    /// pass the original absolute deadline, never a new lifetime on reload.
+    public func delegateSession(
+        to publicKeyDer: Data, expiresAtNs: UInt64
+    ) async throws -> DelegationChain {
+        try await restore()
+        return try await holding(ceremony) {
+            try Task.checkCancellation()
+            guard let session = self.lock.withLock({ self.live }),
+                let credential = try await self.credentials.get(slot: self.slots.session),
+                credential.chain == session.sessionChain
+            else { throw sessionGone() }
+            let chain = credential.chain
+            guard !publicKeyDer.isEmpty, publicKeyDer.count <= 512,
+                chain.delegations.count < 20,
+                publicKeyDer != chain.publicKey,
+                !chain.delegations.contains(where: { $0.delegation.pubkey == publicKeyDer })
+            else { throw misconfigured("a session handoff needs a fresh, bounded public key") }
+            try checkSessionChain(
+                sessionKeyDer: credential.identity.publicKeyDer(), canister: self.canister,
+                maxTimeToLiveNs: nil, chain: chain, nowNs: self.clock.nowNs())
+            guard let parentExpiry = chainExpiryNs(chain) else { throw sessionGone() }
+            let expiry = min(expiresAtNs, parentExpiry)
+            guard expiry > self.clock.nowNs() else { throw sessionGone() }
+            let delegation = Delegation(
+                pubkey: publicKeyDer, expirationNs: expiry,
+                targets: [self.canister.bytes], permissions: nil)
+            // Platform keys return DER ECDSA; delegation signatures need the
+            // same fixed-width encoding as ordinary IC request signatures.
+            let signature = try normaliseSignature(
+                algorithm: credential.identity.algorithm(),
+                sig: await credential.identity.sign(
+                    payload: delegationSignable(delegation: delegation)))
+            try Task.checkCancellation()
+            guard self.lock.withLock({ self.live?.machine === session.machine }),
+                expiry > self.clock.nowNs()
+            else { throw sessionGone() }
+            return DelegationChain(
+                publicKey: chain.publicKey,
+                delegations: chain.delegations + [
+                    SignedDelegation(delegation: delegation, signature: signature)
+                ])
+        }
+    }
