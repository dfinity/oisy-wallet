+/// Exercise the same DER-producing Apple signer used by Secure Enclave keys.
+final class AppleHandoffStore: MapStore, @unchecked Sendable {
+    let identity: KeychainIdentity
+
+    init(identity: KeychainIdentity) { self.identity = identity }
+
+    override func get(slot: String) async throws -> Credential? {
+        guard let credential = try await super.get(slot: slot) else { return nil }
+        guard slot == slotSession else { return credential }
+        var chain = credential.chain
+        chain.delegations[chain.delegations.count - 1].delegation.pubkey = identity.publicKeyDer()
+        return Credential(identity: identity, chain: chain)
+    }
+}
