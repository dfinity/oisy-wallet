{
	"manifest_version": 3,
	"name": "OISY Wallet (proof of concept)",
	"version": "0.0.1",
	"minimum_chrome_version": "116",
	"description": "Lets dapps that only support extension wallets sign with OISY. Local proof of concept against staging.",
	"key": "",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "OISY"
	},
	"side_panel": {
		"default_path": "sidepanel.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["storage", "sidePanel"],
	"host_permissions": ["https://ethereum-sepolia-rpc.publicnode.com/*"],
	"content_scripts": [
		{
			"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
			"exclude_matches": ["https://oisy.com/*", "https://*.oisy.com/*"],
			"js": ["inpage.js"],
			"run_at": "document_start",
			"world": "MAIN",
			"all_frames": false
		},
		{
			"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
			"exclude_matches": ["https://oisy.com/*", "https://*.oisy.com/*"],
			"js": ["content.js"],
			"run_at": "document_start",
			"all_frames": false
		}
	],
	"externally_connectable": {
		"matches": ["http://localhost/*"]
	}
}
